<?xml version="1.0" encoding="UTF-8"?>
<HealthData locale="en_US">

  <!-- Case 1: Old format — stats as attributes, distance in mi -->
  <Workout workoutActivityType="HKWorkoutActivityTypeRunning"
           duration="32.4" durationUnit="min"
           totalDistance="5.02" totalDistanceUnit="mi"
           totalEnergyBurned="410" totalEnergyBurnedUnit="Cal"
           sourceName="Apple Watch"
           startDate="2026-01-10 07:03:12 -0700"
           endDate="2026-01-10 07:35:36 -0700" />

  <!-- Case 2: New format (iOS 16+) — stats in WorkoutStatistics children, distance in km -->
  <Workout workoutActivityType="HKWorkoutActivityTypeRunning"
           duration="45.0" durationUnit="min"
           sourceName="Apple Watch"
           startDate="2026-01-17 06:30:00 -0700"
           endDate="2026-01-17 07:15:00 -0700">
    <WorkoutStatistics type="HKQuantityTypeIdentifierDistanceWalkingRunning"
                       sum="8.05" unit="km" />
    <WorkoutStatistics type="HKQuantityTypeIdentifierActiveEnergyBurned"
                       sum="550" unit="Cal" />
  </Workout>

  <!-- Case 3: Indoor treadmill run — MetadataEntry HKIndoorWorkout=1 -->
  <Workout workoutActivityType="HKWorkoutActivityTypeRunning"
           duration="30.0" durationUnit="min"
           totalDistance="4.0" totalDistanceUnit="mi"
           sourceName="Apple Watch"
           startDate="2026-01-24 19:00:00 -0700"
           endDate="2026-01-24 19:30:00 -0700">
    <MetadataEntry key="HKIndoorWorkout" value="1" />
  </Workout>

  <!-- Case 4: Duplicate of case 1 (same startDate + sourceName → same id) -->
  <Workout workoutActivityType="HKWorkoutActivityTypeRunning"
           duration="32.4" durationUnit="min"
           totalDistance="5.02" totalDistanceUnit="mi"
           totalEnergyBurned="410" totalEnergyBurnedUnit="Cal"
           sourceName="Apple Watch"
           startDate="2026-01-10 07:03:12 -0700"
           endDate="2026-01-10 07:35:36 -0700" />

  <!-- Case 5: Non-running workout — must be skipped entirely -->
  <Workout workoutActivityType="HKWorkoutActivityTypeWalking"
           duration="60.0" durationUnit="min"
           totalDistance="3.0" totalDistanceUnit="mi"
           sourceName="Apple Watch"
           startDate="2026-01-15 08:00:00 -0700"
           endDate="2026-01-15 09:00:00 -0700" />

  <!-- Non-workout records — must be ignored -->
  <Record type="HKQuantityTypeIdentifierHeartRate"
          unit="count/min" value="72"
          sourceName="Apple Watch"
          startDate="2026-01-10 07:10:00 -0700"
          endDate="2026-01-10 07:10:00 -0700" />

</HealthData>
