    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "sax": "^1.3.0"
  }
